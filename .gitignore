# Dependencies (installed via the host profile; never commit)
node_modules/
.npm-cache/

# Runtime diagnostics written by the plugin itself.
# Contains the host's ABSOLUTE paths (bridgeDir, consoleBase) — must never be published.
lib/last-apply-config.json

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~

# Logs and transient state
*.log
*.tmp

# Build artifacts.
# npm pack output is a RELEASE ASSET, not source: committing it would add ~58 KB of
# generated bytes to every clone and make diffs unreadable. Attach it to a GitHub
# Release instead.
*.tgz
*.tar.gz

# Local backups written by scripts/install.mjs before it edits a profile file
*.bak
*.bak-*
